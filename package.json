{
  "name": "kjv-ref",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "parse": "bun run parse-kjv.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report e2e/report",
    "render-scenery": "bun run scripts/render-scenery.ts"
  },
  "dependencies": {
    "@babylonjs/lite": "^1.30.0",
    "date-fns": "^3.6.0",
